{
  "name": "Songbench",
  "type": "client-side-audio-workbench",
  "domain": "https://songbench.online",
  "contact_email": "contact@songbench.online",
  "terms_url": "https://songbench.online/terms/",
  "privacy_url": "https://songbench.online/privacy/",
  "audio_upload": false,
  "server_side_api": "payments-only",
  "server_endpoints": [
    "/api/checkout",
    "/api/webhook",
    "/api/status"
  ],
  "note": "All decoding, processing and WAV encoding happen in the browser with Web Audio API and OfflineAudioContext. The only server endpoints create Waffo checkout sessions and verify signed payment webhooks; they never receive audio files.",
  "capabilities": [
    {
      "id": "speed",
      "range": "50-125%",
      "pitch_preserved": true
    },
    {
      "id": "transpose",
      "range": "-12..+12 semitones"
    },
    {
      "id": "ab-loop",
      "input": "drag on waveform"
    },
    {
      "id": "center-vocal-cancellation",
      "method": "L-R"
    },
    {
      "id": "reverb",
      "method": "generated convolution impulse response"
    },
    {
      "id": "warm-bass",
      "method": "lowshelf EQ"
    },
    {
      "id": "8d-pan",
      "method": "stereo panner automation"
    },
    {
      "id": "presets",
      "count": 8,
      "ids": [
        "original",
        "slowed",
        "nightcore",
        "daycore",
        "spedup",
        "backing",
        "practice",
        "eightd"
      ]
    },
    {
      "id": "batch-export",
      "format": "16-bit WAV + manifest.txt"
    },
    {
      "id": "shareable-practice-sheet",
      "contains": "parameters only, never audio"
    }
  ],
  "ui_languages": [
    "en",
    "es",
    "pt",
    "id",
    "ja",
    "ru"
  ],
  "rights": "No song catalogue, no lyrics, no downloads from video platforms. The user supplies the audio and the rights.",
